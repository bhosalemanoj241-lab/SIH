rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Medical Documents: /medical-documents/{patientId}/{fileName}
    match /medical-documents/{patientId}/{fileName} {
      // Patients and authorized medical personnel can read/download
      allow read: if true;
      // Upload: max 25MB, standard document / image MIME types
      allow write: if request.resource.size < 25 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('application/.*'));
      allow delete: if isAuthenticated();
    }

    // Patient Avatars: /avatars/{userId}/{fileName}
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }
  }
}
